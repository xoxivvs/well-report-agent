# Пример секретов Streamlit Community Cloud.
# Реальный файл .streamlit/secrets.toml НЕ коммитить (он в .gitignore).
# На облаке эти значения задаются в Settings → Secrets приложения.

LLM_API_KEY = "your_key_here"
LLM_BASE_URL = "https://api.proxyapi.ru/v1"
LLM_MODEL = "openai/gpt-4o-mini"

# Опционально:
# DEMO_WELL_ID = "5"
# WELL_REPORT_DATA_DIR = "/tmp/well-report-data"
