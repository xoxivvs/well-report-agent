# Скопируйте в .env и заполните локально (файл .env в .gitignore).
# На Streamlit Community Cloud значения задаются в Settings → Secrets.

# --- LLM (внешний OpenAI-совместимый API) ---
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://api.proxyapi.ru/v1
LLM_MODEL=openai/gpt-4o-mini

# Локальный Ollama (если нужен вместо API):
# USE_OLLAMA=true
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# --- Данные ---
# Переопределяет каталог данных (по умолчанию ./data).
# Полезно на хостингах с read-only ФС: WELL_REPORT_DATA_DIR=/tmp/well-report-data
# WELL_REPORT_DATA_DIR=

# well_id синтетической скважины для демо-разделов телеметрии/геологии
# DEMO_WELL_ID=5
